VITE_SUPPORT_URL=https://buymeacoffee.com/REPLACE_WITH_USERNAME

# --- SEO (set these in Netlify → Site configuration → Environment variables) ---

# IndexNow submission key. Any 8-128 URL-safe characters; generate one with:
#   node -e "console.log(crypto.randomUUID().replaceAll('-',''))"
# The build publishes public/<key>.txt for ownership validation and submits
# every route to Bing/Yandex/Seznam/Naver on each production deploy.
# Without this, IndexNow is inactive and the production build warns loudly.
INDEXNOW_KEY=

# Bing Webmaster Tools verification token (msvalidate.01). Injected into
# <head> at build time by prerender.js. See BING_WEBMASTER_SETUP.md.
BING_SITE_VERIFICATION=
